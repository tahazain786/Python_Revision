import heapq
class Solution:
    def kthSmallest(self, arr, k):
        # Code here
        max_heap = []
        for ele in arr:
            heapq.heappush(max_heap,-ele)
            
            if len(max_heap) > k:
                heapq.heappop(max_heap)
        return -max_heap[0]
        
        

import heapq
class Solution:
    def lastStoneWeight(self, stones: List[int]) -> int:
        max_heap = []
        for i in stones:
            heapq.heappush(max_heap,-i)
        while len(max_heap)>1:
            diff = heapq.heappop(max_heap) - heapq.heappop(max_heap)
            heapq.heappush(max_heap,diff)
        return -(max_heap[0])
        

import heapq
class Solution:
    #Function to return kth largest element from an array.
    def kthLargest(self,arr,k):
        min_heap = []
        for i in arr:
            heapq.heappush(min_heap,i)
            while len(min_heap) > k:
                heapq.heappop(min_heap)
        return min_heap[0]

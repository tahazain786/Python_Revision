arr = ["bana", "appie","banaba", "bananza"]
s= "apple"

for word in arr:
    count = 0
    if len(word) == len(s):
        
        for i in range(len(word)):
            if word[i] != s[i]:
                count += 1
            if count > 1:
                break
            
    if count == 1:
        print(word)
    
